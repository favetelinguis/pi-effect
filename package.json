{
  "name": "pi-effect",
  "version": "0.1.0",
  "description": "pi extension: removes bash and replaces it with typed tools that declare effects, granted per-session by the user.",
  "keywords": ["pi-package", "pi-extension"],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favetelinguis/pi-effect.git"
  },
  "homepage": "https://github.com/favetelinguis/pi-effect",
  "bugs": {
    "url": "https://github.com/favetelinguis/pi-effect/issues"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm run test && node scripts/check-caps-imports.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "typebox": "1.3.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
